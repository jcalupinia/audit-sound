<icecast>
  <limits>
    <clients>${ICECAST_MAX_CLIENTS}</clients>
    <sources>4</sources>
    <queue-size>524288</queue-size>
    <client-timeout>30</client-timeout>
    <header-timeout>15</header-timeout>
    <source-timeout>10</source-timeout>
    <burst-on-connect>1</burst-on-connect>
    <burst-size>65535</burst-size>
  </limits>
  <authentication>
    <source-password>${ICECAST_SOURCE_PASSWORD}</source-password>
    <relay-password>${ICECAST_SOURCE_PASSWORD}</relay-password>
    <admin-user>admin</admin-user>
    <admin-password>${ICECAST_ADMIN_PASSWORD}</admin-password>
  </authentication>
  <!-- La consola (sound.audit-ia.ec) se sirve con COEP require-corp (SharedArrayBuffer del motor WASM):
       el navegador solo deja reproducir audio de OTRO dominio si este lo permite. Sin estas cabeceras
       «Escuchar en vivo» fallaba con MEDIA_ERR_SRC_NOT_SUPPORTED (código 4) y no sonaba nada. -->
  <http-headers>
    <header name="Cross-Origin-Resource-Policy" value="cross-origin" />
    <header name="Access-Control-Allow-Origin" value="*" />
  </http-headers>
  <hostname>${ICECAST_HOSTNAME}</hostname>
  <listen-socket><port>8000</port></listen-socket>
  <paths>
    <logdir>/var/log/icecast2</logdir>
    <webroot>/usr/share/icecast2/web</webroot>
    <adminroot>/usr/share/icecast2/admin</adminroot>
  </paths>
  <logging><loglevel>2</loglevel><logsize>10000</logsize></logging>
  <security>
    <chroot>0</chroot>
    <changeowner><user>icecast2</user><group>icecast</group></changeowner>
  </security>
</icecast>
