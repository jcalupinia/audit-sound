# AUDIT SOUND — plantilla de variables de entorno para el despliegue.
# Copiar los valores en las variables de entorno de Coolify (NO commitear el .env real).

# Contraseñas de Icecast (elegir valores fuertes y únicos).
ICECAST_SOURCE_PASSWORD=cambia-esta-clave-source
ICECAST_ADMIN_PASSWORD=cambia-esta-clave-admin

# Hostname del Icecast. En el modo de UN SOLO DOMINIO no necesita ser público:
# el servicio `web` proxya el stream en /stream.mp3. Deja el valor por defecto.
ICECAST_HOSTNAME=localhost
ICECAST_MAX_CLIENTS=50

# STREAM_URL: NO hace falta en el modo de un solo dominio (la web usa el mismo origen,
# /stream.mp3, servido por su propio proxy). Defínela SOLO si expones Icecast en su propio
# dominio HTTPS aparte:
# STREAM_URL=https://stream.tu-dominio/stream.mp3

# Carpeta del host con tu música (se monta en el contenedor engine en /music, solo lectura).
MUSIC_DIR=/ruta/a/tu/musica

# --- Fuente de música (elegir UNA) ---
# A) Carpeta local: usar MUSIC_DIR (arriba).
# B) Navidrome/Subsonic: definir estas y el engine toma la música del servidor.
#    (Si AUDIT_SOUND_SUBSONIC_URL está puesta, tiene prioridad sobre la carpeta.)
# AUDIT_SOUND_SUBSONIC_URL=https://tu-navidrome
# AUDIT_SOUND_SUBSONIC_USER=usuario
# AUDIT_SOUND_SUBSONIC_PASS=clave
# AUDIT_SOUND_SUBSONIC_PLAYLIST=        # opcional: id de playlist; vacío = aleatorio

# Transición del AutoMix (segundos) y modo (0 skip-silence, 1 pista completa).
# AUDIT_SOUND_TRANSITION=8
# AUDIT_SOUND_MIX_MODE=0

# --- Control API (M5): login + comandos desde el frontend ---
# Credenciales del panel de control (defínelas para habilitar la API):
AUDIT_SOUND_API_USER=dj
AUDIT_SOUND_API_PASS=cambia-esta-clave
# URL pública de la API (solo si expones el panel de control; dominio del puerto 8787):
# API_URL=https://api.tu-dominio
# Endurecimiento (A1.3): allowlist de orígenes CORS del Control API (lista separada
# por comas). Vacío → comodín "*" (retrocompat). Con valor, el engine solo refleja el
# Origin que coincida. El token de sesión viaja por cabecera Authorization: Bearer,
# y /api/login tiene rate limit por IP (8 intentos / 5 min → HTTP 429).
# AUDIT_SOUND_API_ORIGIN=https://audit-sound.audit-ia.ec

# --- Enlace al Command Center (AuditBrain): login de la consola (/pro/login.html) ---
# Reutiliza las Cuentas de Aplicaciones AUDIT-IA del Command Center. Define la base
# del backend INCLUYENDO el prefijo de la API /api/v1 (sin barra final). El endpoint
# real es {base}/apps/auth/login; con la base SIN /api/v1 el login daría 404.
AUDIT_SOUND_CC_API=https://api.audit-ia.ec/api/v1
# Paths opcionales (por defecto los de las Cuentas de Aplicaciones AUDIT-IA; son
# relativos a la base de arriba):
# AUDIT_SOUND_CC_LOGIN_PATH=/apps/auth/login
# AUDIT_SOUND_CC_ME_PATH=/apps/auth/me
#
# MODO DEMO (OPT-IN, por defecto APAGADO): si NO defines AUDIT_SOUND_CC_API, el login
# se BLOQUEA (no entra nadie). Solo para navegar el front sin backend, habilítalo a
# propósito con:
# AUDIT_SOUND_ALLOW_DEMO=1
# La consola valida el acceso a la app con ?app=audit_sound; la cuenta debe tener
# AUDIT SOUND habilitado en «APP · Cuentas AUDIT-IA» del Command Center.
#
# IMPORTANTE (lado Command Center, no en este servicio): añade el ORIGEN de
# AUDIT SOUND (p. ej. https://sound.audit-ia.ec) a la variable CORS_ALLOW_ORIGINS
# del backend auditbrain-python-runner; ese backend ya usa allow_credentials=True,
# necesario para la cookie httponly `device_id` del login.

# --- Agente DJ (servicio dj-agent, interno) — ver deploy/DESPLEGAR_AGENTE_DJ.md ---
# Tokens de acceso a la consola: token:usuario:rol:org;...  (roles: admin, operator, supervisor, listener)
# Genera cada token con:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
DJ_AGENT_DEV_TOKENS=
# IA: copiar los mismos valores que tiene auditbrain-backend en Coolify (las claves son SECRETAS).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=auditia-rutina
LOCAL_LLM_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Presupuesto de IA (USD, estimación): por día/organización y por sesión.
# DJ_AGENT_LLM_BUDGET_USD_DAY=1.0
# DJ_AGENT_LLM_BUDGET_USD_SESSION=0.25
# Login unificado (Fase 7): mismo valor que AUDIT_SOUND_CC_API de la consola (base de la API del Command Center).
DJ_AGENT_CC_API=
# Permisos por correo de la cuenta AUDIT-IA (quien no figure entra como oyente, solo lectura):
DJ_AGENT_CC_ROLES=correo-del-dueno@ejemplo.com:admin;operador@ejemplo.com:operator
