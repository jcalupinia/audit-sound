# AUDIT SOUND — plantilla de variables de entorno para el despliegue.
# Copiar los valores en las variables de entorno de Coolify (NO commitear el .env real).

# Contraseñas de Icecast (elegir valores fuertes y únicos).
ICECAST_SOURCE_PASSWORD=cambia-esta-clave-source
ICECAST_ADMIN_PASSWORD=cambia-esta-clave-admin

# Hostname público del Icecast (dominio del servicio icecast en Coolify).
ICECAST_HOSTNAME=stream.audit-ia
ICECAST_MAX_CLIENTS=50

# URL pública del stream que usará la web (normalmente https://<ICECAST_HOSTNAME>/stream.mp3).
STREAM_URL=https://stream.audit-ia/stream.mp3

# Carpeta del host con tu música (se monta en el contenedor engine en /music, solo lectura).
MUSIC_DIR=/ruta/a/tu/musica
