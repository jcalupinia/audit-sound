# AUDIT SOUND · Agente DJ — variables de entorno (SOLO NOMBRES Y VALORES NO SECRETOS).
# Nunca escribas claves reales en este archivo ni en el repositorio.

# Persistencia (SQLite por defecto)
DJ_AGENT_DB_PATH=dj_agent.db

# Motor: "fake" (simulador, por defecto) o "control_api" (motor C++ real — Fase 2)
DJ_AGENT_ENGINE=fake
DJ_AGENT_ENGINE_URL=
DJ_AGENT_ENGINE_USER=
DJ_AGENT_ENGINE_PASS=
DJ_AGENT_ENGINE_TIMEOUT_SECONDS=3

# Autenticación de DESARROLLO (formato token:usuario:rol:org;...). Roles: admin, operator, supervisor, listener
DJ_AGENT_DEV_TOKENS=

# Control y ciclo del agente
DJ_AGENT_LEASE_SECONDS=120
DJ_AGENT_SCHEDULER_ENABLED=true
DJ_AGENT_SCHEDULER_INTERVAL_SECONDS=5
DJ_AGENT_WS_REPLAY_LIMIT=500

# IA (opcional; sin esto el agente opera solo con reglas). Mismas variables que el Audi Brain Runner.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DJ_AGENT_LLM_TIMEOUT_SECONDS=8
DJ_AGENT_LLM_BUDGET_USD_DAY=1.0
DJ_AGENT_LLM_BUDGET_USD_SESSION=0.25
